# Safe template — copy to `.env.local`, fill values, never commit `.env.local`.
# See also `.env.local.example` (same template).

# Spreadsheet ID, or paste the full /spreadsheets/d/... URL (either works).
# In Google Sheets: Share → add the service account client_email from your JSON as Editor (fixes 403).
GOOGLE_SHEET_ID=

# Tab name for user data (signups, answers, feedback). Default: Sheet1
GOOGLE_SHEET_TAB_NAME=Sheet1

# Tab name for admin prompts (system prompt, beat prompts, question prompts). Default: Sheet2
GOOGLE_SHEET_PROMPTS_TAB=Sheet2

# Service account — use ONE of the two options below.

# Option A: entire JSON on one line (escape inner quotes if needed). private_key uses \n for newlines.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Option B: base64 the whole service account .json file (recommended on Vercel).
# PowerShell: [Convert]::ToBase64String([IO.File]::ReadAllBytes("path\to\key.json"))
GOOGLE_SERVICE_ACCOUNT_KEY_BASE64=

# --- OpenRouter (AI beat generation, server-side only) ---
# Used by /api/challenge/stream-beat. Create a key at https://openrouter.ai/keys
# Never commit real keys; copy this file to .env.local and fill values there.
OPENROUTER_API_KEY=

# Model id on OpenRouter (examples: openai/gpt-4o-mini, anthropic/claude-3.5-sonnet).
OPENROUTER_MODEL=openai/gpt-4o-mini

# Site URL for OpenRouter HTTP-Referer header. Use your production URL when deployed.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Admin API Protection (server-side) ---
# Password for the standard /admin console (prompts + responses). Sent via the
# X-Admin-Password header.
ADMIN_API_PASSWORD=

# Separate password for the /techadmin console (analytics, PostHog session
# links, purchase tracking). This is an ELEVATED credential: it unlocks
# /techadmin AND works on /admin, while ADMIN_API_PASSWORD alone CANNOT unlock
# /techadmin. Set a different, stronger value than ADMIN_API_PASSWORD.
TECHADMIN_API_PASSWORD=

# Comma-separated origins allowed to call admin API (CORS). Leave empty to allow all during dev.
# Example: https://your-site.vercel.app
ADMIN_ALLOWED_ORIGINS=

# Calendly — direct scheduling URL shown on the offer page
CALENDLY_URL=

# Calendly tier booking URLs (read client-side by the offer page). The $497
# Session and $997 Transformation tiers hand off to these hosted Calendly pages,
# which collect payment via Calendly's own Stripe integration. The booking team
# can rotate these without a code change.
NEXT_PUBLIC_CALENDLY_SESSION_URL=
NEXT_PUBLIC_CALENDLY_TRANSFORMATION_URL=

# Signing key for the Calendly invitee.created webhook (/api/webhooks/calendly).
# Get it when you create the webhook subscription: Calendly → Integrations →
# Webhooks. If unset, the webhook accepts events unsigned (dev only).
CALENDLY_WEBHOOK_SIGNING_KEY=

# --- Facebook / Meta Pixel + Conversions API ---
# Browser pixel id (numeric). Powers PageView / InitiateCheckout / Purchase.
NEXT_PUBLIC_FACEBOOK_PIXEL_ID=
# Conversions API (server-side) access token — Events Manager → Settings →
# Conversions API → Generate access token. Enables server-side Purchase events
# (a backstop for the browser pixel) from the Stripe + Calendly webhooks. If
# unset, only the browser pixel fires.
META_CONVERSIONS_API_TOKEN=
# Optional: routes CAPI events to the "Test events" tab while verifying setup.
META_CAPI_TEST_EVENT_CODE=

# --- Stripe (Payments) ---
# Server-only secret key (sk_live_… or sk_test_…). Used by /api/stripe/checkout.
STRIPE_SECRET_KEY=
# Publishable key (safe in client bundle). Currently unused since we use
# Stripe-hosted Checkout; keep for future Elements/embedded usage.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Webhook signing secret (whsec_…). Get from Stripe Dashboard → Developers →
# Webhooks after adding endpoint at /api/webhooks/stripe.
STRIPE_WEBHOOK_SECRET=

# Public origin used for Stripe success/cancel redirects + sitemap/robots.
NEXT_PUBLIC_SITE_URL=https://aimerge.live

# --- Funnel sequence enforcement ---
# When "true", the challenge funnel enforces strict step order: a user can
# only reach /question-N, /processing, /beat-N, /summary, /offer after
# completing the previous step. Leave blank (or "false") in dev/test so
# you can deep-link to any step. Set to "true" in production.
NEXT_PUBLIC_ENFORCE_FUNNEL_ORDER=true

# --- PostHog (analytics / session replay) ---
# The /techadmin console links each response to its PostHog session. The
# session_id + distinct_id are always shown (copyable). To turn the "Open
# recording in PostHog" button into a DIRECT deep-link, also set your numeric
# project id here (PostHog → Settings → Project ID). Without it the button
# falls back to the replay list, where you paste the copied id.
NEXT_PUBLIC_POSTHOG_PROJECT_ID=

# --- Vercel Blob (summary-audio persistence for admin review) ---
# Read-write token for the Blob store. Used by
# /api/challenge/persist-summary-audio to upload each tester's summary MP3 so
# the admin can replay/download it. Create at: Vercel → Storage → your Blob
# store → ".env.local" tab (or `vercel env pull`). If unset, audio persistence
# is skipped gracefully (score/report/summary text still persist) and the
# admin shows "Audio not captured".
BLOB_READ_WRITE_TOKEN=
